PORT=3000

# Comma-separated browser origins allowed to call this API in production.
# Leave unset only when the frontend and API share an origin behind a reverse proxy.
CORS_ORIGIN=https://app.example.com

# Polygon Amoy blockchain setup (chain ID: 80002)
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_RPC_URL=<POLYGON_AMOY_RPC_URL>
BLOCKCHAIN_PRIVATE_KEY=<DEPLOYER_PRIVATE_KEY>

# Smart Contract Addresses (Deployed on Polygon Amoy)
ACCESS_CONTROL_ADDR=<DEPLOYED_ACCESS_CONTROL_ADDRESS>
CREDENTIAL_REGISTRY_ADDR=<DEPLOYED_CREDENTIAL_REGISTRY_ADDRESS>
ASSET_REGISTRY_ADDR=<DEPLOYED_ASSET_REGISTRY_ADDRESS>

# Legacy alias for CredentialRegistry address (backwards compatibility)
BLOCKCHAIN_CONTRACT_ADDRESS=<DEPLOYED_CREDENTIAL_REGISTRY_ADDRESS>
